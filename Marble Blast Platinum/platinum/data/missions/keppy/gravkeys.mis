createDirectionObjects();

gravkeyControl.bindcmd(keyboard, "w", "holdDirection(1);", "releaseDirection(1);");
gravkeyControl.bindcmd(keyboard, "a", "holdDirection(2);", "releaseDirection(2);");
gravkeyControl.bindcmd(keyboard, "s", "holdDirection(3);", "releaseDirection(3);");
